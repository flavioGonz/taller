// =============================================================================
// TALLER SILVER CORE ENGINE — Prisma Schema (multi-tenant, SaaS ready)
// PostgreSQL · Prisma 6 · pooled connections (PgBouncer compatible)
// =============================================================================
generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------
enum Role {
  SUPER_ADMIN     // dueño de la plataforma (multi-taller)
  ADMIN_TALLER    // dueño / administrador del taller
  JEFE_TALLER     // asigna trabajo, aprueba diagnósticos y control de calidad
  RECEPCIONISTA   // recibe el vehículo, arma la OT y presupuesta
  TECNICO         // ejecuta el trabajo
  REPUESTOS       // almacén y compras a proveedores
  CAJA            // facturación y cobranza
  CLIENTE         // portal del cliente
}

enum TenantPlan {
  FREE
  PRO
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum WorkOrderStatus {
  RECEPCION      // vehículo ingresado, esperando diagnóstico
  DIAGNOSTICO    // técnico revisando
  PRESUPUESTADO  // presupuesto emitido, esperando aprobación
  APROBADO       // cliente aprobó
  EN_PROCESO     // trabajo en ejecución
  RECHAZADO      // el cliente no aprobó el presupuesto
  ESPERA_REPUESTO
  CONTROL_CALIDAD
  LAVADO
  FINALIZADO
  ENTREGADO
  CANCELADO
}

/// Tipo de ingreso: define el recorrido que hace el vehículo dentro del taller.
enum WorkOrderKind {
  MANTENIMIENTO
  REPARACION
  DIAGNOSTICO
  CHAPA_PINTURA
  NEUMATICOS
  GARANTIA
  SINIESTRO
  PREENTREGA
}

enum WorkOrderPriority {
  BAJA
  NORMAL
  ALTA
  URGENTE
}

enum WorkOrderItemKind {
  SERVICIO
  REPUESTO
  MANO_OBRA
  OTRO
}

enum StockMovementType {
  ENTRADA
  SALIDA
  AJUSTE
  DEVOLUCION
  MERMA
}

enum DocumentType {
  PRESUPUESTO
  FACTURA
  REMITO
  RECIBO
}

enum DocumentStatus {
  BORRADOR
  EMITIDO
  PAGADO
  PARCIAL
  ANULADO
  VENCIDO
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  DEBITO
  CREDITO
  CHEQUE
  OTRO
}

enum FuelType {
  NAFTA
  DIESEL
  GNC
  ELECTRICO
  HIBRIDO
  OTRO
}

enum AttachmentKind {
  FOTO_INGRESO
  FOTO_DANO
  FOTO_TRABAJO
  DOCUMENTO
  FIRMA
  OTRO
}

// Observabilidad / auto-mejora
enum InsightAgent {
  COMPONENT_INSPECTOR
  STATE_MUTATION_OBSERVER
  REFACTOR_RECOMMENDER
}

enum InsightSeverity {
  INFO
  WARN
  ERROR
  CRITICAL
}

// -----------------------------------------------------------------------------
// TENANCY & IDENTIDAD
// -----------------------------------------------------------------------------
model Tenant {
  id        String       @id @default(cuid())
  slug      String       @unique                 // taller-silver
  name      String                               // Taller Silver
  legalName String?
  taxId     String?                              // RUT
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String       @default("UY")
  timezone  String       @default("America/Montevideo")
  currency  String       @default("UYU")
  locale    String       @default("es-UY")
  logoUrl   String?
  plan      TenantPlan   @default(PRO)
  status    TenantStatus @default(ACTIVE)
  settings  Json         @default("{}")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  users        User[]
  customers    Customer[]
  vehicles     Vehicle[]
  workOrders   WorkOrder[]
  services     ServiceCatalog[]
  parts        Part[]
  suppliers    Supplier[]
  warehouses   Warehouse[]
  stockMoves   StockMovement[]
  documents    Document[]
  payments     Payment[]
  bays         Bay[]
  auditLogs    AuditLog[]
  insights     SystemInsight[]
  counters     Counter[]
  appointments Appointment[]
  partsOrders  PartsOrder[]
  followUps    FollowUp[]

  @@index([status])
  @@map("tenants")
}

model User {
  id            String    @id @default(cuid())
  tenantId      String?                            // null solo para SUPER_ADMIN global
  email         String
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  role          Role      @default(TECNICO)
  avatarUrl     String?
  isActive      Boolean   @default(true)
  mustChangePwd Boolean   @default(false)
  lastLoginAt   DateTime?
  // Datos de técnico
  specialty     String?
  hourlyRate    Decimal?  @db.Decimal(12, 2)
  // Vínculo opcional con la ficha de cliente (rol CLIENTE del portal)
  customerId    String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant           Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sessions         Session[]
  assignedOrders   WorkOrder[]    @relation("WorkOrderTechnician")
  createdOrders    WorkOrder[]    @relation("WorkOrderCreatedBy")
  statusChanges    WorkOrderStatusHistory[]
  timeLogs         WorkOrderTimeLog[]
  auditLogs        AuditLog[]
  stockMoves       StockMovement[]
  qualityChecks    QualityCheck[]

  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@index([email])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  tenantId     String?
  refreshToken String   @unique                   // hash del refresh token
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Numeradores por tenant (OT-2026-00001, FAC-A-000123, ...)
model Counter {
  id       String @id @default(cuid())
  tenantId String
  key      String                 // "work_order" | "presupuesto" | "factura"
  period   String @default("*")   // "*" | "2026"
  value    Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, period])
  @@map("counters")
}

// -----------------------------------------------------------------------------
// CLIENTES & VEHÍCULOS
// -----------------------------------------------------------------------------
model Customer {
  id          String    @id @default(cuid())
  tenantId    String
  code        String?                              // código interno
  isCompany   Boolean   @default(false)
  firstName   String?
  lastName    String?
  companyName String?
  docType     String?                              // CI / RUT / DNI
  docNumber   String?
  email       String?
  phone       String?
  phoneAlt    String?
  address     String?
  city        String?
  notes       String?
  creditLimit Decimal?  @db.Decimal(12, 2)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles     Vehicle[]
  workOrders   WorkOrder[]
  documents    Document[]
  portalUser   User?
  appointments Appointment[]
  followUps    FollowUp[]

  @@unique([tenantId, docNumber])
  @@index([tenantId, lastName])
  @@index([tenantId, companyName])
  @@index([tenantId, phone])
  @@map("customers")
}

model Vehicle {
  id           String    @id @default(cuid())
  tenantId     String
  customerId   String
  plate        String                              // matrícula
  vin          String?                             // chasis
  engineNumber String?
  // Marca y modelo quedan siempre como texto (es lo que se imprime y lo que
  // permite cargar un vehículo raro sin pelearse con el catálogo); los ids
  // apuntan al catálogo cuando se eligieron de la lista.
  brand        String
  model        String
  brandId      String?
  modelId      String?
  year         Int?
  color        String?
  fuel         FuelType  @default(NAFTA)
  transmission String?
  engineSize   String?
  mileage      Int?                                // último km conocido
  insurance    String?
  policyNumber String?
  photoUrl     String?                             // foto de portada de la ficha
  features     Json      @default("{}")            // detalles visuales: polarizado, llantas, etc.
  notes        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  brandRef     VehicleBrand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  modelRef     VehicleModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  workOrders   WorkOrder[]
  appointments Appointment[]
  followUps    FollowUp[]
  photos       VehiclePhoto[]

  @@unique([tenantId, plate])
  @@index([tenantId, vin])
  @@index([customerId])
  @@map("vehicles")
}

// Bahías / puestos de trabajo del taller
model Bay {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  kind     String? // elevador, alineación, chapa, pintura...
  isActive Boolean @default(true)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrders   WorkOrder[]
  appointments Appointment[]

  @@unique([tenantId, name])
  @@map("bays")
}

// -----------------------------------------------------------------------------
// ÓRDENES DE TRABAJO (OT)
// -----------------------------------------------------------------------------
model WorkOrder {
  id           String            @id @default(cuid())
  tenantId     String
  number       String                                   // OT-2026-00001
  /// Identificador inmutable de la reparación, para auditoría y trazabilidad
  /// externa (aseguradoras, peritos, garantías). Nunca se reutiliza ni cambia.
  auditId      String            @unique
  customerId   String
  vehicleId    String
  technicianId String?
  createdById  String?
  bayId        String?
  kind         WorkOrderKind     @default(REPARACION)
  status       WorkOrderStatus   @default(RECEPCION)
  priority     WorkOrderPriority @default(NORMAL)

  // Recepción
  complaint        String?      // relato del cliente
  diagnosis        String?      // diagnóstico técnico
  workPerformed    String?      // trabajo realizado
  internalNotes    String?
  mileageIn        Int?
  fuelLevel        Int?         // 0-100
  checklistIn      Json         @default("{}")
  receivedAt       DateTime     @default(now())
  promisedAt       DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  deliveredAt      DateTime?

  // Totales (persistidos para reporting rápido; recalculados en cada mutación)
  laborTotal    Decimal  @default(0) @db.Decimal(12, 2)
  partsTotal    Decimal  @default(0) @db.Decimal(12, 2)
  discountTotal Decimal  @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal  @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal  @default(0) @db.Decimal(12, 2)
  currency      String   @default("UYU")

  customerApproved   Boolean   @default(false)
  customerApprovedAt DateTime?
  signatureUrl       String?
  rejectionReason    String?
  warrantyUntil      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle    Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  technician User?                    @relation("WorkOrderTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  createdBy  User?                    @relation("WorkOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  bay        Bay?                     @relation(fields: [bayId], references: [id], onDelete: SetNull)
  items       WorkOrderItem[]
  history     WorkOrderStatusHistory[]
  timeLogs    WorkOrderTimeLog[]
  attachments Attachment[]
  documents   Document[]
  stockMoves  StockMovement[]
  inspections Inspection[]
  quotes      Quote[]
  partsOrders PartsOrder[]
  qualityChecks QualityCheck[]
  delivery      Delivery?
  appointment   Appointment?
  followUps     FollowUp[]
  insuranceCase InsuranceCase?

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, receivedAt])
  @@index([technicianId, status])
  @@index([vehicleId])
  @@map("work_orders")
}

model WorkOrderItem {
  id          String            @id @default(cuid())
  tenantId    String
  workOrderId String
  kind        WorkOrderItemKind @default(SERVICIO)
  serviceId   String?
  partId      String?
  description String
  quantity    Decimal           @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal           @db.Decimal(12, 2)
  discountPct Decimal           @default(0) @db.Decimal(5, 2)
  taxPct      Decimal           @default(22) @db.Decimal(5, 2)
  total       Decimal           @default(0) @db.Decimal(12, 2)
  hours       Decimal?          @db.Decimal(8, 2)
  approved    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workOrder WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  service   ServiceCatalog? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  part      Part?           @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@index([tenantId, partId])
  @@map("work_order_items")
}

model WorkOrderStatusHistory {
  id          String          @id @default(cuid())
  tenantId    String
  workOrderId String
  fromStatus  WorkOrderStatus?
  toStatus    WorkOrderStatus
  userId      String?
  note        String?
  createdAt   DateTime        @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workOrderId, createdAt])
  @@map("work_order_status_history")
}

model WorkOrderTimeLog {
  id          String    @id @default(cuid())
  tenantId    String
  workOrderId String
  userId      String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  minutes     Int?
  note        String?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([userId, startedAt])
  @@map("work_order_time_logs")
}

model Attachment {
  id          String         @id @default(cuid())
  tenantId    String
  workOrderId String?
  kind        AttachmentKind @default(OTRO)
  url         String
  filename    String?
  mimeType    String?
  size        Int?
  uploadedById String?
  createdAt   DateTime       @default(now())

  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("attachments")
}

// -----------------------------------------------------------------------------
// CATÁLOGO, INVENTARIO Y REPUESTOS
// -----------------------------------------------------------------------------
model ServiceCatalog {
  id            String   @id @default(cuid())
  tenantId      String
  code          String?
  name          String
  description   String?
  category      String?
  estimatedHours Decimal? @db.Decimal(8, 2)
  price         Decimal  @db.Decimal(12, 2)
  taxPct        Decimal  @default(22) @db.Decimal(5, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  WorkOrderItem[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@map("service_catalog")
}

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  taxId     String?
  email     String?
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parts  Part[]
  orders PartsOrder[]

  @@unique([tenantId, name])
  @@map("suppliers")
}

model Warehouse {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  location String?
  isDefault Boolean @default(false)

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stock      PartStock[]
  stockMoves StockMovement[]

  @@unique([tenantId, name])
  @@map("warehouses")
}

model Part {
  id          String   @id @default(cuid())
  tenantId    String
  sku         String
  barcode     String?
  name        String
  description String?
  brand       String?
  category    String?
  unit        String   @default("UN")
  cost        Decimal  @default(0) @db.Decimal(12, 2)
  price       Decimal  @default(0) @db.Decimal(12, 2)
  taxPct      Decimal  @default(22) @db.Decimal(5, 2)
  minStock    Decimal  @default(0) @db.Decimal(12, 3)
  supplierId  String?
  location    String?
  imageUrl    String?                       // foto del repuesto para el listado
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier   Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stock       PartStock[]
  stockMoves  StockMovement[]
  items       WorkOrderItem[]
  orderItems  PartsOrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, name])
  @@index([tenantId, barcode])
  @@map("parts")
}

model PartStock {
  id          String  @id @default(cuid())
  tenantId    String
  partId      String
  warehouseId String
  quantity    Decimal @default(0) @db.Decimal(12, 3)
  reserved    Decimal @default(0) @db.Decimal(12, 3)
  updatedAt   DateTime @updatedAt

  part      Part      @relation(fields: [partId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([partId, warehouseId])
  @@index([tenantId])
  @@map("part_stock")
}

model StockMovement {
  id          String            @id @default(cuid())
  tenantId    String
  partId      String
  warehouseId String
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 3)
  unitCost    Decimal?          @db.Decimal(12, 2)
  workOrderId String?
  userId      String?
  reference   String?
  note        String?
  createdAt   DateTime          @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  part      Part       @relation(fields: [partId], references: [id], onDelete: Cascade)
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([partId, createdAt])
  @@map("stock_movements")
}

// -----------------------------------------------------------------------------
// PRESUPUESTOS / FACTURACIÓN
// -----------------------------------------------------------------------------
model Document {
  id          String         @id @default(cuid())
  tenantId    String
  type        DocumentType
  number      String
  status      DocumentStatus @default(BORRADOR)
  customerId  String
  workOrderId String?
  issueDate   DateTime       @default(now())
  dueDate     DateTime?
  currency    String         @default("UYU")
  exchangeRate Decimal       @default(1) @db.Decimal(12, 4)
  subtotal    Decimal        @default(0) @db.Decimal(12, 2)
  discount    Decimal        @default(0) @db.Decimal(12, 2)
  tax         Decimal        @default(0) @db.Decimal(12, 2)
  total       Decimal        @default(0) @db.Decimal(12, 2)
  paid        Decimal        @default(0) @db.Decimal(12, 2)
  notes       String?
  pdfUrl      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  workOrder WorkOrder?     @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  lines     DocumentLine[]
  payments  Payment[]

  @@unique([tenantId, type, number])
  @@index([tenantId, status])
  @@index([customerId])
  @@map("documents")
}

model DocumentLine {
  id          String  @id @default(cuid())
  tenantId    String
  documentId  String
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  taxPct      Decimal @default(22) @db.Decimal(5, 2)
  total       Decimal @default(0) @db.Decimal(12, 2)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_lines")
}

model Payment {
  id         String        @id @default(cuid())
  tenantId   String
  documentId String
  method     PaymentMethod @default(EFECTIVO)
  amount     Decimal       @db.Decimal(12, 2)
  currency   String        @default("UYU")
  reference  String?
  paidAt     DateTime      @default(now())
  createdAt  DateTime      @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, paidAt])
  @@map("payments")
}

// -----------------------------------------------------------------------------
// AUDITORÍA & CAPA DE AUTO-MEJORA
// -----------------------------------------------------------------------------
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String            // create | update | delete | login | status_change
  entity    String            // WorkOrder | Customer | ...
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// Salida estructurada de los sub-agentes de observabilidad
model SystemInsight {
  id         String          @id @default(cuid())
  tenantId   String?
  agent      InsightAgent
  severity   InsightSeverity @default(INFO)
  code       String                       // SLOW_ENDPOINT | N_PLUS_ONE | A11Y_MISSING_LABEL ...
  title      String
  detail     String?
  target     String?                      // ruta, componente o modelo afectado
  metrics    Json            @default("{}")
  suggestion String?
  resolved   Boolean         @default(false)
  occurrences Int            @default(1)
  firstSeenAt DateTime       @default(now())
  lastSeenAt  DateTime       @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([agent, code, target])
  @@index([severity, resolved])
  @@map("system_insights")
}

// =============================================================================
//  CATÁLOGO DE VEHÍCULOS (marcas · modelos · logos)
//  Filas globales (tenantId = null) compartidas por todos los talleres, más las
//  altas propias de cada taller para lo que el catálogo no cubre.
// =============================================================================
model VehicleBrand {
  id        String   @id @default(cuid())
  tenantId  String?                       // null = catálogo global
  slug      String
  name      String
  logoFile  String?                       // archivo en /brands del frontend
  country   String?
  isActive  Boolean  @default(true)
  source    String   @default("catalog")  // catalog | manual
  createdAt DateTime @default(now())

  models   VehicleModel[]
  vehicles Vehicle[]

  @@unique([tenantId, slug])
  @@index([name])
  @@map("vehicle_brands")
}

model VehicleModel {
  id        String   @id @default(cuid())
  tenantId  String?
  brandId   String
  name      String
  bodyType  String?                       // sedan, hatchback, SUV, pick-up…
  yearFrom  Int?
  yearTo    Int?
  isActive  Boolean  @default(true)
  source    String   @default("catalog")
  createdAt DateTime @default(now())

  brand    VehicleBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]

  @@unique([brandId, name, tenantId])
  @@index([brandId, name])
  @@map("vehicle_models")
}

// =============================================================================
//  CITAS / TURNOS
// =============================================================================
enum AppointmentStatus {
  PROGRAMADA
  CONFIRMADA
  EN_TALLER      // el vehículo llegó y se abrió la OT
  NO_ASISTIO
  CANCELADA
}

model Appointment {
  id          String            @id @default(cuid())
  tenantId    String
  customerId  String?
  vehicleId   String?
  // Datos sueltos para cuando la cita se toma sin ficha previa
  contactName String?
  contactPhone String?
  plate       String?
  reason      String?
  scheduledAt DateTime
  durationMin Int               @default(60)
  bayId       String?
  technicianId String?
  status      AppointmentStatus @default(PROGRAMADA)
  notes       String?
  workOrderId String?           @unique
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicle    Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  bay        Bay?       @relation(fields: [bayId], references: [id], onDelete: SetNull)
  workOrder  WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([tenantId, scheduledAt])
  @@index([tenantId, status])
  @@map("appointments")
}

// =============================================================================
//  INSPECCIÓN (recepción y entrega) — fotos reales con marcadores de daño
// =============================================================================
enum InspectionKind {
  INGRESO
  EGRESO
}

enum PhotoAngle {
  FRENTE
  TRASERA
  LATERAL_IZQ
  LATERAL_DER
  TECHO
  INTERIOR
  TABLERO
  MOTOR
  BAUL
  RUEDAS
  DETALLE
  OTRO
}

enum DamageType {
  RAYON
  ABOLLADURA
  ROTURA
  FALTANTE
  OXIDO
  FISURA
  DESGASTE
  MANCHA
  REPARACION_PREVIA
  OTRO
}

enum DamageSeverity {
  LEVE
  MODERADO
  GRAVE
}

model Inspection {
  id          String         @id @default(cuid())
  tenantId    String
  workOrderId String
  kind        InspectionKind @default(INGRESO)
  mileage     Int?
  fuelLevel   Int?           // 0-100
  // Inventario del vehículo: rueda de auxilio, gato, criquet, documentos…
  checklist   Json           @default("{}")
  observations String?
  signatureUrl String?       // firma del cliente capturada en pantalla
  signedName  String?
  signedDoc   String?
  signedAt    DateTime?
  performedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workOrder WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  photos    InspectionPhoto[]
  damages   DamageMark[]

  @@unique([workOrderId, kind])
  @@index([tenantId, createdAt])
  @@map("inspections")
}

model InspectionPhoto {
  id           String     @id @default(cuid())
  tenantId     String
  inspectionId String
  angle        PhotoAngle @default(OTRO)
  url          String
  width        Int?
  height       Int?
  position     Int        @default(0)
  createdAt    DateTime   @default(now())

  inspection Inspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  damages    DamageMark[]

  @@index([inspectionId, position])
  @@map("inspection_photos")
}

/// Marcador de daño puesto sobre la foto real del vehículo.
/// x/y son relativos (0..1) al ancho/alto de la foto, así el pin queda en su
/// lugar en cualquier pantalla y en el PDF.
model DamageMark {
  id           String         @id @default(cuid())
  tenantId     String
  inspectionId String
  photoId      String?
  x            Float
  y            Float
  partCode     String                         // ver PARTS en @taller/shared
  type         DamageType     @default(RAYON)
  severity     DamageSeverity @default(LEVE)
  preexisting  Boolean        @default(true)  // ya venía así al ingresar
  note         String?
  createdAt    DateTime       @default(now())

  inspection Inspection       @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  photo      InspectionPhoto? @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([tenantId, partCode])
  @@map("damage_marks")
}

// =============================================================================
//  PRESUPUESTOS VERSIONADOS + APROBACIÓN / RECHAZO
// =============================================================================
enum QuoteStatus {
  BORRADOR
  ENVIADO
  APROBADO
  APROBADO_PARCIAL
  RECHAZADO
  VENCIDO
  ANULADO
  SUPERSEDIDO     // reemplazado por una versión posterior
}

enum ItemDecision {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum ApprovalChannel {
  TELEFONO
  WHATSAPP
  EMAIL
  PRESENCIAL
  OTRO
}

model Quote {
  id          String      @id @default(cuid())
  tenantId    String
  workOrderId String
  number      String                        // PRE-2026-000001
  version     Int         @default(1)
  status      QuoteStatus @default(BORRADOR)
  validUntil  DateTime?
  currency    String      @default("UYU")
  notes       String?
  terms       String?
  /// Resumen de la rotura tal como se le explica al cliente en el PDF
  summary       String?
  estimatedDays Int?      // tiempo de entrega estimado, en días hábiles
  warrantyDays  Int?      @default(90)
  pdfUrl        String?

  subtotal      Decimal @default(0) @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @default(0) @db.Decimal(12, 2)
  // Total sólo de los ítems aprobados: es lo que realmente se va a trabajar
  approvedTotal Decimal @default(0) @db.Decimal(12, 2)

  sentAt        DateTime?
  sentChannel   ApprovalChannel?
  decidedAt     DateTime?
  decisionChannel ApprovalChannel?
  decidedByName String?                     // quién del lado del cliente decidió
  decisionNote  String?
  rejectionReason String?
  registeredById String?                    // usuario del taller que registró la decisión

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workOrder WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  items     QuoteItem[]

  @@unique([tenantId, number, version])
  @@index([workOrderId, version])
  @@index([tenantId, status])
  @@map("quotes")
}

model QuoteItem {
  id          String            @id @default(cuid())
  tenantId    String
  quoteId     String
  kind        WorkOrderItemKind @default(SERVICIO)
  serviceId   String?
  partId      String?
  description String
  detail      String?
  quantity    Decimal           @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal           @db.Decimal(12, 2)
  discountPct Decimal           @default(0) @db.Decimal(5, 2)
  taxPct      Decimal           @default(22) @db.Decimal(5, 2)
  total       Decimal           @default(0) @db.Decimal(12, 2)
  hours       Decimal?          @db.Decimal(8, 2)
  optional    Boolean           @default(false)   // sugerido, no imprescindible
  urgent      Boolean           @default(false)   // seguridad: conviene hacerlo ya
  decision    ItemDecision      @default(PENDIENTE)
  decisionNote String?
  position    Int               @default(0)
  createdAt   DateTime          @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, position])
  @@map("quote_items")
}

// =============================================================================
//  PEDIDOS DE REPUESTOS A PROVEEDOR (la etapa "espera repuesto")
// =============================================================================
enum PartsOrderStatus {
  BORRADOR
  SOLICITADO
  CONFIRMADO
  EN_TRANSITO
  RECIBIDO_PARCIAL
  RECIBIDO
  CANCELADO
}

model PartsOrder {
  id          String           @id @default(cuid())
  tenantId    String
  number      String
  workOrderId String?
  supplierId  String?
  status      PartsOrderStatus @default(BORRADOR)
  expectedAt  DateTime?
  receivedAt  DateTime?
  reference   String?
  notes       String?
  total       Decimal          @default(0) @db.Decimal(12, 2)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrder WorkOrder?       @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  supplier  Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items     PartsOrderItem[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("parts_orders")
}

model PartsOrderItem {
  id           String  @id @default(cuid())
  tenantId     String
  partsOrderId String
  partId       String?
  description  String
  quantity     Decimal @db.Decimal(12, 3)
  received     Decimal @default(0) @db.Decimal(12, 3)
  unitCost     Decimal @default(0) @db.Decimal(12, 2)
  total        Decimal @default(0) @db.Decimal(12, 2)

  order PartsOrder @relation(fields: [partsOrderId], references: [id], onDelete: Cascade)
  part  Part?      @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([partsOrderId])
  @@map("parts_order_items")
}

// =============================================================================
//  CONTROL DE CALIDAD Y ENTREGA
// =============================================================================
enum QualityResult {
  APROBADO
  APROBADO_CON_OBSERVACIONES
  RECHAZADO
}

model QualityCheck {
  id           String        @id @default(cuid())
  tenantId     String
  workOrderId  String
  result       QualityResult @default(APROBADO)
  checklist    Json          @default("{}")
  roadTest     Boolean       @default(false)
  roadTestKm   Int?
  observations String?
  inspectorId  String?
  createdAt    DateTime      @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inspector User?     @relation(fields: [inspectorId], references: [id], onDelete: SetNull)

  @@index([workOrderId, createdAt])
  @@map("quality_checks")
}

model Delivery {
  id            String   @id @default(cuid())
  tenantId      String
  workOrderId   String   @unique
  deliveredAt   DateTime @default(now())
  receivedBy    String?               // quién retira el vehículo
  receivedDoc   String?
  mileageOut    Int?
  fuelLevelOut  Int?
  signatureUrl  String?
  observations  String?
  warrantyDays  Int?     @default(90)
  warrantyUntil DateTime?
  nextServiceKm Int?
  nextServiceAt DateTime?
  deliveredById String?
  createdAt     DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, deliveredAt])
  @@map("deliveries")
}

// =============================================================================
//  POSTVENTA
// =============================================================================
enum FollowUpKind {
  SATISFACCION
  RECORDATORIO_SERVICE
  GARANTIA
  COBRANZA
  OTRO
}

enum FollowUpStatus {
  PENDIENTE
  HECHO
  DESCARTADO
}

model FollowUp {
  id          String         @id @default(cuid())
  tenantId    String
  workOrderId String?
  customerId  String?
  vehicleId   String?
  kind        FollowUpKind   @default(SATISFACCION)
  status      FollowUpStatus @default(PENDIENTE)
  dueAt       DateTime
  doneAt      DateTime?
  channel     ApprovalChannel?
  rating      Int?                       // 1-5 en encuestas de satisfacción
  notes       String?
  assignedToId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, dueAt])
  @@map("follow_ups")
}

/// Relevamiento fotográfico del vehículo: vive en su ficha, no en una OT.
model VehiclePhoto {
  id         String     @id @default(cuid())
  tenantId   String
  vehicleId  String
  url        String
  angle      PhotoAngle @default(OTRO)
  caption    String?
  isPrimary  Boolean    @default(false)
  workOrderId String?                    // si salió de una recepción, de cuál
  createdAt  DateTime   @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, createdAt])
  @@map("vehicle_photos")
}

// =============================================================================
//  ASEGURADORAS — condiciones de trabajo y expediente de siniestro
//  El taller trabaja para varias compañías y cada una tiene sus reglas para
//  autorizar la reparación, qué repuestos acepta y cómo se cobra.
// =============================================================================

enum PartsPolicy {
  ORIGINAL          // sólo repuesto original
  ALTERNATIVO       // acepta alternativo / aftermarket
  USADO             // acepta usado o reciclado
  MIXTO             // según pieza, lo define el perito
}

enum PartsSuppliedBy {
  TALLER            // el taller consigue y factura los repuestos
  ASEGURADORA       // los manda la compañía
  MIXTO
}

enum InvoiceTo {
  ASEGURADORA       // se factura todo a la compañía
  CLIENTE           // el cliente paga y le reintegran
  MIXTO             // franquicia al cliente, resto a la compañía
}

enum DeductibleCollectedBy {
  TALLER            // el taller cobra la franquicia al cliente
  ASEGURADORA
  NO_APLICA
}

enum AuthorizationChannel {
  PORTAL
  EMAIL
  TELEFONO
  APP
  PERITO_PRESENCIAL
  WHATSAPP
}

enum AuthorizationStatus {
  SIN_ENVIAR
  ENVIADO
  EN_ANALISIS
  AUTORIZADO
  AUTORIZADO_PARCIAL
  RECHAZADO
  VENCIDO
}

model Insurer {
  id         String  @id @default(cuid())
  tenantId   String?                        // null = catálogo compartido
  slug       String
  name       String                         // nombre comercial
  legalName  String?
  taxId      String?                        // RUT
  logoFile   String?
  phone      String?
  email      String?
  website    String?
  claimsPhone String?                       // línea de siniestros
  claimsEmail String?
  portalUrl  String?
  worksAuto  Boolean @default(true)         // opera el ramo automotor
  isActive   Boolean @default(true)
  notes      String?
  source     String  @default("catalog")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  terms    InsurerTerms?
  contacts InsurerContact[]
  cases    InsuranceCase[]

  @@unique([tenantId, slug])
  @@index([name])
  @@map("insurers")
}

/// Cómo trabaja ESTE taller con ESTA aseguradora. Es lo que después valida el
/// sistema antes de dejar mandar una reparación a autorizar.
model InsurerTerms {
  id        String @id @default(cuid())
  tenantId  String
  insurerId String @unique

  // --- autorización de la reparación ---
  requiresAuthorization Boolean              @default(true)
  authorizationChannel  AuthorizationChannel @default(EMAIL)
  authorizationSlaHours Int?                 // cuánto suele tardar la respuesta
  requiresClaimNumber   Boolean              @default(true)   // nº de denuncia
  requiresAdjuster      Boolean              @default(true)   // peritaje previo
  requiresPhotos        Boolean              @default(true)
  minPhotos             Int                  @default(6)
  requiresDamageMap     Boolean              @default(true)   // daños marcados
  requiresQuoteFormat   String?                               // formato/planilla exigida
  requiredDocuments     Json                 @default("[]")   // ver DOCUMENT_REQUIREMENTS

  // --- repuestos ---
  partsPolicy     PartsPolicy     @default(MIXTO)
  partsSuppliedBy PartsSuppliedBy @default(TALLER)
  partsMarkupPct  Decimal?        @db.Decimal(5, 2)
  requiresPartsQuotes Int         @default(0)   // cotizaciones a adjuntar

  // --- dinero ---
  laborRate       Decimal?  @db.Decimal(12, 2) // valor hora acordado
  laborDiscountPct Decimal? @db.Decimal(5, 2)
  partsDiscountPct Decimal? @db.Decimal(5, 2)
  currency        String    @default("UYU")
  invoiceTo       InvoiceTo @default(ASEGURADORA)
  deductibleBy    DeductibleCollectedBy @default(TALLER)
  paymentTermDays Int       @default(30)
  retentionPct    Decimal?  @db.Decimal(5, 2)

  // --- plazos y garantías ---
  maxRepairDays Int?
  warrantyDays  Int     @default(90)
  agreementRef  String?                  // nº de convenio con el taller
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  insurer Insurer @relation(fields: [insurerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("insurer_terms")
}

model InsurerContact {
  id        String  @id @default(cuid())
  tenantId  String
  insurerId String
  name      String
  role      String?          // perito, liquidador, mesa de autorizaciones…
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())

  insurer Insurer @relation(fields: [insurerId], references: [id], onDelete: Cascade)

  @@index([insurerId])
  @@map("insurer_contacts")
}

/// Expediente del siniestro dentro de la OT.
model InsuranceCase {
  id          String @id @default(cuid())
  tenantId    String
  workOrderId String @unique
  insurerId   String

  policyNumber String?
  claimNumber  String?                     // nº de denuncia / siniestro
  claimDate    DateTime?
  adjusterName String?
  adjusterPhone String?
  adjusterVisitAt DateTime?

  deductible     Decimal? @db.Decimal(12, 2)   // franquicia
  deductibleBy   DeductibleCollectedBy @default(TALLER)
  insurerAmount  Decimal  @default(0) @db.Decimal(12, 2)
  customerAmount Decimal  @default(0) @db.Decimal(12, 2)

  status            AuthorizationStatus @default(SIN_ENVIAR)
  authorizationRef  String?                    // nº de orden / autorización
  authorizedAmount  Decimal? @db.Decimal(12, 2)
  authorizedAt      DateTime?
  authorizedBy      String?
  sentAt            DateTime?
  rejectionReason   String?
  documents         Json @default("{}")        // checklist de lo entregado
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  insurer   Insurer   @relation(fields: [insurerId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([insurerId])
  @@map("insurance_cases")
}
