# /etc/taller-silver/taller.env  — chmod 600, owner root:taller
NODE_ENV=production
# ---- Base de datos (CT103 pve01) ----
DATABASE_URL=postgresql://taller:CAMBIAR@192.168.99.111:5432/taller_silver?schema=public&connection_limit=10&pool_timeout=20
DIRECT_DATABASE_URL=postgresql://taller:CAMBIAR@192.168.99.111:5432/taller_silver?schema=public
# ---- API ----
API_HOST=127.0.0.1
API_PORT=3001
JWT_SECRET=CAMBIAR_POR_64_HEX
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
COOKIE_DOMAIN=taller.infratec.com.uy
COOKIE_SECURE=true
CORS_ORIGIN=https://taller.infratec.com.uy
RATE_LIMIT_MAX=300
LOG_LEVEL=info
UPLOAD_DIR=/var/lib/taller-silver/uploads
# ---- Observabilidad ----
OBSERVABILITY_ENABLED=true
SLOW_ENDPOINT_MS=400
SLOW_QUERY_MS=200
SOCKET_LEAK_THRESHOLD=500
# ---- Web ----
PORT=3000
API_INTERNAL_URL=http://127.0.0.1:3001
